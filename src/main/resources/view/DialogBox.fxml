<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<fx:root alignment="TOP_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
         minWidth="-Infinity" prefWidth="440.0" spacing="10.0" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
    </padding>
    <children>
        <Label fx:id="dialog" styleClass="dialog-label" text="Label" wrapText="true"
               maxWidth="270.0" />
        <!-- An ImageView cannot draw a border of its own, so the avatar is framed by
             the StackPane around it. -->
        <StackPane styleClass="avatar" maxHeight="-Infinity" maxWidth="-Infinity">
            <children>
                <ImageView fx:id="displayPicture" fitHeight="60.0" fitWidth="60.0"
                           pickOnBounds="true" preserveRatio="true" />
            </children>
        </StackPane>
    </children>
</fx:root>
